{
  "name": "app-in-toss-by-gh",
  "private": true,
  "scripts": {
    "bootstrap": "node ./scripts/bootstrap.mjs",
    "dev": "granite dev",
    "build": "npm run doctor:release && ait build",
    "upload:test": "npm run doctor:upload && node ./scripts/ait-upload-test.mjs",
    "deploy": "npm run upload:test",
    "deploy:token:add": "ait token add",
    "doctor": "node ./scripts/doctor.mjs --mode local",
    "doctor:repo": "node ./scripts/doctor.mjs --mode repo",
    "doctor:local": "node ./scripts/doctor.mjs --mode local",
    "doctor:release": "node ./scripts/doctor.mjs --mode release",
    "doctor:upload": "node ./scripts/doctor.mjs --mode upload",
    "verify": "npm run doctor:repo && npm run lint && npm run typecheck && npm test",
    "clean:generated": "node ./scripts/clean-generated.mjs",
    "public:check": "node ./scripts/public-check.mjs",
    "cors:print": "node ./scripts/apps-in-toss-origins.mjs",
    "docs:sync": "node ./scripts/docs/sync-apps-in-toss-docs.mjs",
    "docs:check": "node ./scripts/docs/check-apps-in-toss-docs.mjs",
    "docs:check:strict": "node ./scripts/docs/check-apps-in-toss-docs.mjs --strict",
    "test:harness": "node --test test/harness/*.test.mjs",
    "test": "npm run test:harness && jest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@apps-in-toss/framework": "2.0.9",
    "@granite-js/react-native": "1.0.7",
    "@granite-js/native": "1.0.7",
    "@toss/tds-react-native": "1.3.8",
    "brick-module": "0.5.0",
    "react": "19.2.3",
    "react-native": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@testing-library/react-native": "^12.9.0",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.0",
    "@granite-js/plugin-env": "1.0.7",
    "@granite-js/plugin-router": "1.0.7",
    "@granite-js/plugin-hermes": "1.0.7",
    "babel-preset-granite": "1.0.7",
    "react-test-renderer": "19.2.3",
    "jest": "^29.7.0",
    "typescript": "^5.8.3",
    "@biomejs/biome": "^1.9.4"
  },
  "dependenciesMeta": {
    "hermes-compiler": {
      "unplugged": true
    }
  }
}
